rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Everything that decides whether an account is paid for. These are written only
    // with Admin SDK credentials — by the trial route and the Stripe/RevenueCat
    // webhooks — which bypass these rules entirely. The client is refused on create
    // as well as update: create used to be unrestricted, which meant a hand-made
    // client could seed its own profile with an active subscription, or with a trial
    // ending in the next century.
    function billingFields() {
      return [
        'subscriptionStatus',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'trialStartedAt',
        'trialEndsAt'
      ];
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                     && !request.resource.data.keys().hasAny(billingFields());
      allow update: if isOwner(userId)
                     && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(billingFields());

      match /accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }
      match /cards/{cardId} {
        allow read, write: if isOwner(userId);
      }
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                       && request.resource.data.amountCents is int
                       && request.resource.data.amountCents > 0;
        allow update, delete: if isOwner(userId);
      }
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId);
      }
      match /recurringRules/{ruleId} {
        allow read, write: if isOwner(userId);
      }
      match /contracts/{contractId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
