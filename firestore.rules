rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Everything that decides whether an account is paid for. These are written only
    // with Admin SDK credentials — by the trial route and the Stripe/RevenueCat
    // webhooks — which bypass these rules entirely. The client is refused on create
    // as well as update: create used to be unrestricted, which meant a hand-made
    // client could seed its own profile with an active subscription, or with a trial
    // ending in the next century.
    function billingFields() {
      return [
        'subscriptionStatus',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'trialStartedAt',
        'trialEndsAt'
      ];
    }

    /**
     * Shared spaces live outside /users because more than one person reads them.
     *
     * A space holds only what someone chose to put in it: expenses entered there and
     * settlements between participants. No rule here can reach a member's own accounts,
     * cards or entries — sharing the house expenses must never become a window into a
     * salary, and keeping the shared data in its own place is what guarantees that.
     */
    function spaceData(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data;
    }
    function isSpaceMember(spaceId) {
      return request.auth != null && request.auth.uid in spaceData(spaceId).memberUids;
    }

    match /spaces/{spaceId} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.memberUids;
      }
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }
      function isInvited() {
        return request.auth != null
               && request.auth.token.email != null
               && request.auth.token.email.lower() in resource.data.pendingEmails;
      }
      // An invited person may do exactly one thing: put themselves in and take their
      // own invitation out. Anything else on the document stays untouched.
      function onlyJoining() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberUids', 'pendingEmails'])
               && request.auth.uid in request.resource.data.memberUids
               && !(request.auth.token.email.lower() in request.resource.data.pendingEmails)
               && request.resource.data.ownerUid == resource.data.ownerUid;
      }

      allow read: if isMember() || isInvited();
      allow create: if request.auth != null
                     && request.resource.data.ownerUid == request.auth.uid
                     && request.auth.uid in request.resource.data.memberUids;
      allow update: if (isMember() && request.resource.data.ownerUid == resource.data.ownerUid)
                     || (isInvited() && onlyJoining());
      allow delete: if isOwner();

      match /expenses/{expenseId} {
        allow read, write: if isSpaceMember(spaceId);
      }
      match /settlements/{settlementId} {
        allow read, write: if isSpaceMember(spaceId);
      }
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                     && !request.resource.data.keys().hasAny(billingFields());
      allow update: if isOwner(userId)
                     && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(billingFields());

      match /accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }
      match /cards/{cardId} {
        allow read, write: if isOwner(userId);
      }
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }
      // One document per category, holding that category's monthly limit.
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }

      // Goals and known annual bills: an amount, a date and what is already put away.
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // One record per statement import, so it can be listed and undone.
      match /imports/{importId} {
        allow read, write: if isOwner(userId);
      }
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                       && request.resource.data.amountCents is int
                       && request.resource.data.amountCents > 0;
        allow update, delete: if isOwner(userId);
      }
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId);
      }
      match /recurringRules/{ruleId} {
        allow read, write: if isOwner(userId);
      }
      match /contracts/{contractId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
